{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "functions": {
    "src/app/api/cron/scrape/route.ts": {
      "regions": ["iad1"]
    }
  },
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/analyze-and-notify",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 0 * * 0"
    },
    {
      "path": "/api/cron/learn-feedback",
      "schedule": "0 3 * * *"
    }
  ]
}
